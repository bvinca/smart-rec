# SmartRecruiter backend environment template.
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.

# ----- Database -----
# Use SQLite for local development, PostgreSQL for production / dissertation evaluation.
DATABASE_URL=sqlite:///./smartrecruiter.db
# DATABASE_URL=postgresql+psycopg2://smartrecruiter:smartrecruiter@localhost:5432/smartrecruiter

# ----- OpenAI (optional) -----
# Required for the LLM-based RAG generator and the LLM XAI narrative.
# Leave blank to fall back to local Sentence-BERT only (which is the dissertation's primary path).
OPENAI_API_KEY=

# ----- Model selection -----
# "sbert"      - local Sentence-BERT (all-MiniLM-L6-v2, dissertation default)
# "openai"     - OpenAI text-embedding-3-large
# "auto"       - sbert when no OPENAI_API_KEY, openai otherwise
EMBEDDING_BACKEND=sbert
SBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o-mini

# ----- Auth / security -----
# MUST be a random 32+ byte string in production.  Backend will refuse to start with the default in non-debug mode.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Server -----
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ----- Vector store -----
CHROMA_PERSIST_DIR=./chroma_db

# ----- CORS -----
# Comma-separated list of allowed front-end origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- SMTP (optional) -----
# Used by the recruiter email feature.  Leave SMTP_ENABLED=False to skip.
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SmartRecruiter
SMTP_USE_TLS=True
SMTP_TIMEOUT=10

# ----- Privacy -----
# When True, name / email / phone / address are stripped from text before any LLM call (blind screening).
LLM_PII_REDACTION=True
